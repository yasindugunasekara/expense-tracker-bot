# =================================================================
# EXPENSE TRACKER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# =================================================================

# -----------------------------------------------------------------
# 1. Supabase Database Configuration (Required)
# -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon

# -----------------------------------------------------------------
# 2. Telegram Bot Configuration (Required)
# -----------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdjefGhIJKlmNoPQRsTUVwxyZ
# Your numeric Telegram user ID (security restriction)
TELEGRAM_ALLOWED_USER_ID=123456789

# -----------------------------------------------------------------
# 3. Internal Backend API URL
# When running with default all-in-one Docker container: http://127.0.0.1:8000
# When running with microservices compose: http://api:8000
# -----------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
EXPENSE_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------
# 4. Google Gemini AI (Required for receipt scanning & OCR)
# -----------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 5. Email Notifications & Reports (Required for email automation)
# -----------------------------------------------------------------
GMAIL_REPORT_TO=your-email@example.com

# -----------------------------------------------------------------
# 6. FastMCP Server Configuration (For Cursor, Claude, Antigravity)
# Transport options:
#   stdio: Standard I/O (Default, recommended for SSH bridge)
#   sse: Server-Sent Events (Exposes HTTP endpoint on MCP_PORT)
# -----------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001
# Set to 'true' if you want FastMCP to run as a persistent SSE background daemon in supervisor
START_MCP=false
